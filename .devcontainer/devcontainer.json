{
    "name": "Java Inventory System",
    "image": "mcr.microsoft.com/devcontainers/java:17",
    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "17",
            "installMaven": true
        }
    },
    "forwardPorts": [
        8080
    ],
    "postStartCommand": "mvn spring-boot:run &",
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack"
            ]
        }
    },
    "portsAttributes": {
        "8080": {
            "label": "API",
            "onAutoForward": "openBrowser"
        }
    }
}